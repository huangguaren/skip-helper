<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 只需要看到「有启动图标的应用」：逐个开关的列表就是这些，规则文件里的包名哈希
         也只能在这些应用上生效。用 <queries> 声明可见性，不申请 QUERY_ALL_PACKAGES。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- 跳过成功后的悬浮提示。targetSdk 30+ 后台服务弹 Toast 会被系统拦截，
         必须用 TYPE_APPLICATION_OVERLAY 悬浮窗。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 只在用户主动 `adb shell pm grant` 之后才生效：HyperOS 会把侧载应用的无障碍开关弹回，
         而零售版又不给 shell WRITE_SECURE_SETTINGS。拿不到就什么都不做。 -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".RuleEditActivity"
            android:exported="false"
            android:label="编辑规则" />

        <activity
            android:name=".GlobalRulesActivity"
            android:exported="false"
            android:label="全局规则" />

        <service
            android:name=".SkipService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
